{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AI Mahjong NPC v1 content contract",
  "oneOf": [
    {"$ref": "#/$defs/scenarioCatalog"},
    {"$ref": "#/$defs/behaviorPack"},
    {"$ref": "#/$defs/proposalMetadata"}
