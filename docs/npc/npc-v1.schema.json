  "$defs": {
    "dialogueAct": {
      "enum": ["urge_player", "tease", "console", "praise", "brag", "grumble", "callout", "congratulate", "vow", "deflect", "question"]
    },
    "trigger": {
      "oneOf": [{"type": "object", "properties": {"kind": {"const": "domain_event"}, "event_type": {"const": "meld_claimed"}, "fact_filter": {"type": "object", "properties": {"claim_kind": {"const": "pong"}, "claimed_from_is_npc": {"const": true}}, "required": ["claim_kind", "claimed_from_is_npc"], "additionalProperties": false}}, "required": ["kind", "event_type", "fact_filter"], "additionalProperties": false}, {"type": "object", "properties": {"kind": {"const": "player_idle"}, "duration_band": {"enum": ["short", "medium", "long"]}}, "required": ["kind", "duration_band"], "additionalProperties": false}, {"type": "object", "properties": {"kind": {"const": "hand_phase"}, "phase": {"const": "first_draw"}}, "required": ["kind", "phase"], "additionalProperties": false}, {"type": "object", "properties": {"kind": {"const": "exchange_followup"}, "requires_act": {"$ref": "#/$defs/dialogueAct"}}, "required": ["kind", "requires_act"], "additionalProperties": false}]
    },
    "guard": {
      "oneOf": [{"type": "object", "properties": {"kind": {"const": "game_active"}, "expect": {"type": "boolean"}}, "required": ["kind", "expect"], "additionalProperties": false}, {"type": "object", "properties": {"kind": {"const": "speaker_not_current_player"}, "expect": {"type": "boolean"}}, "required": ["kind", "expect"], "additionalProperties": false}, {"type": "object", "properties": {"kind": {"const": "speaker_not_actor"}, "expect": {"type": "boolean"}}, "required": ["kind", "expect"], "additionalProperties": false}, {"type": "object", "properties": {"kind": {"const": "emotion_in"}, "set": {"type": "array", "items": {"enum": ["neutral", "amused", "pleased", "annoyed", "resigned", "smug"]}, "minItems": 1, "maxItems": 6, "uniqueItems": true}}, "required": ["kind", "set"], "additionalProperties": false}, {"type": "object", "properties": {"kind": {"const": "fact_query"}, "query": {"const": "hand_claim_count_by_seat_min"}, "params": {"type": "object", "properties": {"by": {"const": "actor"}, "against": {"const": "observer"}, "min": {"type": "integer", "minimum": 1, "maximum": 65535}}, "required": ["by", "against", "min"], "additionalProperties": false}}, "required": ["kind", "query", "params"], "additionalProperties": false}, {"type": "object", "properties": {"kind": {"const": "fact_query"}, "query": {"const": "last_hand_winner"}, "params": {"type": "object", "properties": {"who": {"const": "player"}}, "required": ["who"], "additionalProperties": false}}, "required": ["kind", "query", "params"], "additionalProperties": false}, {"type": "object", "properties": {"kind": {"const": "fact_query"}, "query": {"const": "win_streak_min"}, "params": {"type": "object", "properties": {"who": {"const": "player"}, "min": {"type": "integer", "minimum": 1, "maximum": 65535}}, "required": ["who", "min"], "additionalProperties": false}}, "required": ["kind", "query", "params"], "additionalProperties": false}, {"type": "object", "properties": {"kind": {"const": "fact_query"}, "query": {"const": "relationship_affinity_max"}, "params": {"type": "object", "properties": {"toward": {"enum": ["actor", "event_target", "player"]}, "affinity_max": {"type": "integer", "minimum": -32768, "maximum": 32767}}, "required": ["toward", "affinity_max"], "additionalProperties": false}}, "required": ["kind", "query", "params"], "additionalProperties": false}]
    },
    "scene": {
      "type": "object",
      "properties": {
        "scenario_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[a-z][a-z0-9_.-]*(?![\\s\\S])"
        },
        "title": {"type": "string", "minLength": 1, "maxLength": 256},
        "category": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[a-z][a-z0-9_.-]*(?![\\s\\S])"
        },
        "trigger": {"$ref": "#/$defs/trigger"},
        "priority": {"enum": ["low", "normal", "high", "critical"]},
        "cooldown": {
          "type": "object",
          "properties": {
            "per_scenario_s": {"type": "integer", "minimum": 0, "maximum": 3600},
            "per_speaker_s": {"type": "integer", "minimum": 0, "maximum": 3600}
          },
          "required": ["per_scenario_s", "per_speaker_s"],
          "additionalProperties": false
        },
        "silence_policy": {"const": "allow"},
        "max_followups": {"enum": [0, 1]},
        "observer_filter": {"enum": ["all_npc", "all_npc_except_actor", "all_npc_except_current_player", "actor_only"]},
        "guards": {"type": "array", "items": {"$ref": "#/$defs/guard"}, "minItems": 0, "maxItems": 16},
        "notes": {"type": "string", "minLength": 1, "maxLength": 1024},
        "$comment": {"type": "string", "minLength": 1, "maxLength": 1024}
      },
      "required": [
        "scenario_id",
        "title",
        "category",
        "trigger",
        "priority",
        "cooldown",
        "silence_policy",
        "max_followups",
        "observer_filter"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {"properties": {"trigger": {"properties": {"kind": {"const": "exchange_followup"}}}}},
          "then": {"properties": {"max_followups": {"const": 0}}}
        }
      ]
    },
    "line": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[a-z][a-z0-9_.-]*(?![\\s\\S])"
        },
        "dialogue_act": {"$ref": "#/$defs/dialogueAct"},
        "locale": {"const": "zh-Hans"},
        "text": {"type": "string", "minLength": 1, "maxLength": 512},
        "voice": {
          "type": "object",
          "properties": {
            "voice_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "pattern": "^[a-z][a-z0-9_.-]*(?![\\s\\S])"
            },
            "audio": {
              "oneOf": [{"type": "object", "properties": {"mode": {"const": "clip"}, "clip": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[a-z][a-z0-9_.-]*(?![\\s\\S])"}, "audio_sha256": {"type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-f0-9]{64}(?![\\s\\S])"}}, "required": ["mode", "clip", "audio_sha256"], "additionalProperties": false}, {"type": "object", "properties": {"mode": {"const": "variants"}, "variants": {"type": "array", "items": {"type": "object", "properties": {"bindings": {"type": "object", "properties": {"claim_count": {"type": "integer", "minimum": 1, "maximum": 65535}, "streak": {"type": "integer", "minimum": 1, "maximum": 65535}, "tile": {"type": "integer", "minimum": 0, "maximum": 33}}, "required": [], "additionalProperties": false, "minProperties": 1}, "text": {"type": "string", "minLength": 1, "maxLength": 512}, "clip": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[a-z][a-z0-9_.-]*(?![\\s\\S])"}, "audio_sha256": {"type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-f0-9]{64}(?![\\s\\S])"}}, "required": ["bindings", "text", "clip", "audio_sha256"], "additionalProperties": false}, "minItems": 1, "maxItems": 64}}, "required": ["mode", "variants"], "additionalProperties": false}, {"type": "object", "properties": {"mode": {"const": "tts"}}, "required": ["mode"], "additionalProperties": false}]
            }
          },
          "required": ["voice_id"],
          "additionalProperties": false
        },
        "gesture": {"enum": ["idle", "talk", "draw", "discard", "claim", "win", "react"]},
        "slots": {
          "type": "array",
          "items": {
            "oneOf": [{"type": "object", "properties": {"name": {"const": "claim_count"}, "source": {"const": "public_fact"}, "formatter": {"const": "hand_claim_count_by_seat"}}, "required": ["name", "source", "formatter"], "additionalProperties": false}, {"type": "object", "properties": {"name": {"const": "streak"}, "source": {"const": "public_fact"}, "formatter": {"const": "win_streak"}}, "required": ["name", "source", "formatter"], "additionalProperties": false}, {"type": "object", "properties": {"name": {"const": "tile"}, "source": {"const": "public_fact"}, "formatter": {"const": "tile_name"}}, "required": ["name", "source", "formatter"], "additionalProperties": false}]
          },
          "minItems": 0,
          "maxItems": 3,
          "uniqueItems": true
        },
        "weight": {"type": "integer", "minimum": 1, "maximum": 65535},
        "tags": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "^[a-z][a-z0-9_.-]*(?![\\s\\S])"
          },
          "minItems": 0,
          "maxItems": 16,
          "uniqueItems": true
        }
      },
      "required": ["id", "dialogue_act", "locale", "text", "voice", "slots", "weight", "tags"],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {"properties": {"slots": {"minItems": 1}}},
          "then": {
            "properties": {
              "voice": {"properties": {"audio": {"properties": {"mode": {"not": {"const": "clip"}}}}}}
            }
          }
        },
        {
          "if": {"properties": {"slots": {"maxItems": 0}}},
          "then": {
            "properties": {
              "voice": {"properties": {"audio": {"properties": {"mode": {"not": {"const": "variants"}}}}}}
            }
          }
        }
      ]
    },
    "scenarioCatalog": {
      "type": "object",
      "properties": {
        "schema_version": {"const": 1},
