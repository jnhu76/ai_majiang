              "maxItems": 16,
              "uniqueItems": true
            }
          },
          "required": ["fixture_id"],
          "additionalProperties": false
        },
        "payload_ref": {"type": "string", "minLength": 1, "maxLength": 256},
        "review_status": {
          "enum": ["draft", "schema_validated", "semantically_validated", "coverage_reviewed", "human_reviewed", "approved", "rejected", "superseded"]
        },
        "licensing_notes": {"type": "string", "minLength": 1, "maxLength": 1024},
        "content_hash": {"type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-f0-9]{64}(?![\\s\\S])"},
        "supersedes": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[a-z][a-z0-9_.-]*(?![\\s\\S])"
        },
        "superseded_by": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[a-z][a-z0-9_.-]*(?![\\s\\S])"
        },
        "human_reviewer": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[a-z][a-z0-9_.-]*(?![\\s\\S])"
        },
        "review_notes": {"type": "string", "minLength": 1, "maxLength": 1024},
        "$comment": {"type": "string", "minLength": 1, "maxLength": 1024}
      },
      "required": [
        "schema_version",
        "proposal_id",
        "teacher_role",
        "scenario_id",
        "target_pack",
        "proposal_kind",
        "source_event_schema",
        "character_revision",
        "generator_model",
        "generator_prompt_version",
        "generated_at",
        "inputs",
        "review_status",
        "licensing_notes"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {"properties": {"review_status": {"not": {"const": "draft"}}}},
          "then": {"required": ["payload_ref", "content_hash"]}
        },
        {
          "if": {"properties": {"review_status": {"enum": ["human_reviewed", "approved"]}}},
          "then": {"required": ["human_reviewer"]}
        }
      ]
    }
  }
}
