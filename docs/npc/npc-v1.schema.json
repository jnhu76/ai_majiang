                "maxLength": 256,
                "pattern": "^[a-z][a-z0-9_.-]*(?![\\s\\S])"
              },
              "reactions": {
                "type": "array",
                "items": {
                  "oneOf": [{"type": "object", "properties": {"delivery": {"const": "silent"}, "reaction_id": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[a-z][a-z0-9_.-]*(?![\\s\\S])"}, "match": {"type": "object", "properties": {"observer_scope": {"enum": ["any", "event_actor", "event_target", "others"]}, "trait_bands": {"type": "object", "properties": {"talkative": {"type": "array", "items": {"type": "number", "minimum": 0, "maximum": 1}, "minItems": 2, "maxItems": 2}, "teasing": {"type": "array", "items": {"type": "number", "minimum": 0, "maximum": 1}, "minItems": 2, "maxItems": 2}, "composure": {"type": "array", "items": {"type": "number", "minimum": 0, "maximum": 1}, "minItems": 2, "maxItems": 2}, "competitiveness": {"type": "array", "items": {"type": "number", "minimum": 0, "maximum": 1}, "minItems": 2, "maxItems": 2}}, "required": [], "additionalProperties": false}, "guards": {"type": "array", "items": {"$ref": "#/$defs/guard"}, "minItems": 0, "maxItems": 16}}, "required": [], "additionalProperties": false}, "emotion_rule": {"type": "object", "properties": {"emotion": {"enum": ["neutral", "amused", "pleased", "annoyed", "resigned", "smug"]}, "intensity_delta": {"type": "number", "minimum": -1, "maximum": 1}, "cap": {"type": "number", "minimum": 0, "maximum": 1}}, "required": ["emotion", "intensity_delta"], "additionalProperties": false, "allOf": [{"if": {"properties": {"emotion": {"const": "neutral"}}}, "then": {"properties": {"intensity_delta": {"const": 0}}, "not": {"required": ["cap"]}}}]}, "relationship_rule": {"type": "object", "properties": {"toward": {"enum": ["actor", "event_target", "player"]}, "affinity_delta": {"type": "integer", "minimum": -32768, "maximum": 32767}, "familiarity_delta": {"type": "integer", "minimum": -32768, "maximum": 32767}}, "required": ["toward"], "additionalProperties": false, "anyOf": [{"required": ["affinity_delta"]}, {"required": ["familiarity_delta"]}]}, "gesture_hint": {"enum": ["idle", "talk", "draw", "discard", "claim", "win", "react"]}, "$comment": {"type": "string", "minLength": 1, "maxLength": 1024}}, "required": ["delivery", "reaction_id", "match", "gesture_hint"], "additionalProperties": false}, {"type": "object", "properties": {"delivery": {"const": "speak"}, "reaction_id": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[a-z][a-z0-9_.-]*(?![\\s\\S])"}, "match": {"type": "object", "properties": {"observer_scope": {"enum": ["any", "event_actor", "event_target", "others"]}, "trait_bands": {"type": "object", "properties": {"talkative": {"type": "array", "items": {"type": "number", "minimum": 0, "maximum": 1}, "minItems": 2, "maxItems": 2}, "teasing": {"type": "array", "items": {"type": "number", "minimum": 0, "maximum": 1}, "minItems": 2, "maxItems": 2}, "composure": {"type": "array", "items": {"type": "number", "minimum": 0, "maximum": 1}, "minItems": 2, "maxItems": 2}, "competitiveness": {"type": "array", "items": {"type": "number", "minimum": 0, "maximum": 1}, "minItems": 2, "maxItems": 2}}, "required": [], "additionalProperties": false}, "guards": {"type": "array", "items": {"$ref": "#/$defs/guard"}, "minItems": 0, "maxItems": 16}}, "required": [], "additionalProperties": false}, "emotion_rule": {"type": "object", "properties": {"emotion": {"enum": ["neutral", "amused", "pleased", "annoyed", "resigned", "smug"]}, "intensity_delta": {"type": "number", "minimum": -1, "maximum": 1}, "cap": {"type": "number", "minimum": 0, "maximum": 1}}, "required": ["emotion", "intensity_delta"], "additionalProperties": false, "allOf": [{"if": {"properties": {"emotion": {"const": "neutral"}}}, "then": {"properties": {"intensity_delta": {"const": 0}}, "not": {"required": ["cap"]}}}]}, "relationship_rule": {"type": "object", "properties": {"toward": {"enum": ["actor", "event_target", "player"]}, "affinity_delta": {"type": "integer", "minimum": -32768, "maximum": 32767}, "familiarity_delta": {"type": "integer", "minimum": -32768, "maximum": 32767}}, "required": ["toward"], "additionalProperties": false, "anyOf": [{"required": ["affinity_delta"]}, {"required": ["familiarity_delta"]}]}, "gesture_hint": {"enum": ["idle", "talk", "draw", "discard", "claim", "win", "react"]}, "$comment": {"type": "string", "minLength": 1, "maxLength": 1024}, "dialogue_act": {"$ref": "#/$defs/dialogueAct"}, "lines": {"type": "array", "items": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[a-z][a-z0-9_.-]*(?![\\s\\S])"}, "minItems": 1, "maxItems": 64, "uniqueItems": true}}, "required": ["delivery", "reaction_id", "match", "gesture_hint", "dialogue_act", "lines"], "additionalProperties": false}]
                },
                "minItems": 1,
                "maxItems": 64
              }
            },
            "required": ["scenario_id", "reactions"],
            "additionalProperties": false
          },
          "minItems": 1,
          "maxItems": 1024
        },
        "$comment": {"type": "string", "minLength": 1, "maxLength": 1024}
      },
      "required": ["schema_version", "pack_id", "version", "catalog", "character_ref", "lines", "scenarios"],
      "additionalProperties": false
    },
    "proposalMetadata": {
      "type": "object",
      "properties": {
        "schema_version": {"const": 1},
        "proposal_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^\\d{4}-\\d{2}-\\d{2}-[a-z_]+-\\d+(?![\\s\\S])"
        },
        "teacher_role": {
          "enum": ["scene_explorer", "character_behavior_designer", "dialogue_writer", "coverage_critic", "quality_reviewer"]
        },
        "scenario_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[a-z][a-z0-9_.-]*(?![\\s\\S])"
        },
        "target_pack": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[a-z][a-z0-9_.-]*@(0|[1-9][0-9]{0,8})\\.(0|[1-9][0-9]{0,8})\\.(0|[1-9][0-9]{0,8})(?![\\s\\S])"
        },
        "proposal_kind": {"enum": ["scenario", "reaction", "candidate_lines", "coverage_report", "quality_review"]},
        "source_event_schema": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[a-z][a-z0-9_.-]*@(0|[1-9][0-9]{0,8})\\.(0|[1-9][0-9]{0,8})\\.(0|[1-9][0-9]{0,8})(?![\\s\\S])"
        },
        "character_revision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[a-z][a-z0-9_.-]*@(0|[1-9][0-9]{0,8})\\.(0|[1-9][0-9]{0,8})\\.(0|[1-9][0-9]{0,8})(?![\\s\\S])"
        },
        "generator_model": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[a-z][a-z0-9_.-]*(?![\\s\\S])"
        },
        "generator_prompt_version": {"type": "string", "minLength": 1, "maxLength": 256},
        "generated_at": {"type": "string", "minLength": 1, "maxLength": 256, "format": "date-time"},
        "inputs": {
          "type": "object",
