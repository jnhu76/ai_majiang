{
  "$comment": "Scenario Catalog v1 文档夹具。三个 Golden 主场景与一个一次性回应场景。",
  "schema_version": 1,
  "catalog_revision": "2026.11.0",
  "scenarios": [
    {
      "scenario_id": "player.idle.long",
      "title": "玩家长时间未出牌",
      "category": "player_behavior.waiting",
      "trigger": {
        "kind": "player_idle",
        "duration_band": "long"
      },
      "guards": [
        {
          "kind": "game_active",
          "expect": true
        },
        {
          "kind": "speaker_not_current_player",
          "expect": true
        }
      ],
      "priority": "normal",
      "cooldown": {
        "per_scenario_s": 90,
        "per_speaker_s": 6
      },
      "silence_policy": "allow",
      "max_followups": 1,
      "observer_filter": "all_npc_except_current_player",
      "notes": "SocialCue 由表现层经可注入时钟产生，不属于权威游戏记录。"
    },
    {
      "scenario_id": "player.idle.followup_tease",
      "title": "有人催玩家后，另一角色打趣催牌者",
      "category": "dialogue.followup",
      "trigger": {
        "kind": "exchange_followup",
        "requires_act": "urge_player"
      },
      "guards": [
        {
          "kind": "game_active",
          "expect": true
        },
        {
          "kind": "speaker_not_current_player",
          "expect": true
        },
        {
          "kind": "speaker_not_actor",
          "expect": true
        }
      ],
      "priority": "low",
      "cooldown": {
        "per_scenario_s": 120,
        "per_speaker_s": 8
      },
      "silence_policy": "allow",
      "max_followups": 0,
      "observer_filter": "all_npc_except_actor",
      "notes": "一次性回应链：回应不再触发回应，防止无限对话。"
    },
    {
      "scenario_id": "game_action.meld.claimed_of_my_discard",
      "title": "自己的舍牌刚被他人碰走",
      "category": "game_action.claim",
      "trigger": {
        "kind": "domain_event",
        "event_type": "meld_claimed",
        "fact_filter": {
          "claim_kind": "pong",
          "claimed_from_is_npc": true
        }
      },
      "guards": [],
      "priority": "high",
      "cooldown": {
        "per_scenario_s": 20,
        "per_speaker_s": 6
      },
      "silence_policy": "allow",
      "max_followups": 0,
      "observer_filter": "all_npc",
      "notes": "actor 是碰牌者，target 是被碰的舍牌者。"
    },
    {
      "scenario_id": "continuity.hand_opening_after_player_win",
      "title": "玩家上一手获胜后的新一手开场",
      "category": "continuity.last_hand",
      "trigger": {
        "kind": "hand_phase",
        "phase": "first_draw"
      },
      "guards": [
        {
          "kind": "fact_query",
          "query": "last_hand_winner",
          "params": {
            "who": "player"
          }
        }
      ],
      "priority": "normal",
      "cooldown": {
        "per_scenario_s": 0,
        "per_speaker_s": 6
      },
      "silence_policy": "allow",
      "max_followups": 0,
      "observer_filter": "all_npc",
      "notes": "依赖已确认的上一手公开摘要（CharacterMemory），未确认胜负不触发。"
    }
  ]
}
